#pragma once

// Copy this file to mqtt_secrets.h (gitignored) and fill in real values
// before building firmware/src/mqtt_test_harness.cpp. Never commit real
// MQTT credentials.
//
// This is a *separate* broker identity from any other project's ESP32
// device credentials -- do not reuse another device's MQTT username here.
// Ask the broker owner for a distinct client with publish/subscribe rights
// scoped to the agricontrol/# topics only (see mqtt_test_harness.cpp's file
// header for the exact topic names), not the full topic space.

#define MQTT_HOST "your-broker-host"
#define MQTT_PORT 8883
#define MQTT_CLIENT_ID "agricontrol-test-harness"
#define MQTT_USER "your-mqtt-username"
#define MQTT_PASSWORD "your-mqtt-password"
